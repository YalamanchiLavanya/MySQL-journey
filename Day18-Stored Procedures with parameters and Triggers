--- IN AND OUT PARAMETERS

mysql> DELIMITER //
mysql> CREATE PROCEDURE addBonus(IN empid INT,
    ->                                   OUT bonus DECIMAL(10,2))
    -> BEGIN
    -> UPDATE EMPLOYEES
    -> SET SALARY=SALARY+BONUS
    -> WHERE EMP_ID=EMPID;
    -> SELECT SALARY
    -> INTO BONUS
    -> FROM EMPLOYEES
    -> WHERE EMP_ID=EMPID;
    -> END //

mysql> DELIMITER ;
mysql> SET @B=5000;
mysql> CALL addBonus(101,@B);
mysql> SELECT @B;





Introduction to Triggers
==========================
-->A Trigger is a special type stored program that automatically executes in a response 
to a specific event INSERT,UPDATE,OR DELETE
-->Occurring on a specified table. Unlike a stored procedure 
 A trigger is never called directly. The database engine invokes it automatically when 
the trigger event happens

Syntax
=======

DELIMITER //
CREATE TRIGGER trigger_name
{BEFORE | AFTER}{INSERT|DELETE|UPDATE}
ON TABLE_NAME
FOR EACH ROW
BEGIN
   ---trigger logic
   ---use NEW.column_name for inserted/updated values
   ---use OLD.column_name for deleted /previous values
END //

DELIMITER ; 

EXAMPLE
---------
mysql> DELIMITER //
mysql> CREATE TRIGGER trg_before_insert_salary
    -> BEFORE INSERT
    -> ON EMPLOYEES
    -> FOR EACH ROW
    -> BEGIN
    -> IF NEW.SALARY<20000 THEN
    -> SIGNAL SQLSTATE '45000'
    -> SET MESSAGE_TEXT='SALARY CANNOT BE LESS THAN 20000';
    -> END IF;
    -> END //
Query OK, 0 rows affected (0.06 sec)

mysql> DELIMITER ;
mysql> INSERT INTO EMPLOYEES VALUES(106,'ARJUN','IT',15000,3,'DELHI');
ERROR 1644 (45000): SALARY CANNOT BE LESS THAN 20000
mysql> INSERT INTO EMPLOYEES VALUES(106,'ARJUN','IT',55000,3,'DELHI');
Query OK, 1 row affected (0.05 sec)



















































