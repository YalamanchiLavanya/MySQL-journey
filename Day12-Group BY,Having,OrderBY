GROUP BY HAVING
---------------

** Total units sold per category where total units >20
--------------------------------------------------------
select category,sum(units_sold)as total_units
from sales
group by category
having total_units>20;

**Total revenue per region where revenue >50000
------------------------------------------------
select region,sum(units_sold*unit_price)as revenue
from sales
group by region
having revenue>50000;

** Count of products per category with more than 2 products
-----------------------------------------------------------
select category,count(product) as product_count
from sales
group by category
having product_count>2;

** Average units price per category <5000
-----------------------------------------------
select category
AVG(unit_price) as avg_price
FROM sales
GROUP BY category
HAVING AVG(unit_price)<5000;

** Regions with more than 1 electronics products
--------------------------------------------------
select region,count(product)as electronics_count
from sales
where category='electronics'
group by region
having electronics_count>1;



GROPU BY ORDER BY
-------------------

** Category and total units sold ,ordered descending
------------------------------------------------------
select category,sum(units_sold) as total_units
from sales
group by category
order by total_units desc;

** Average unit price per region,ordered alphabetically
---------------------------------------------------------
select region,avg(unit_price)as avg_price
from sales
group by region
order by region asc;

** Total revenue per category ,highest first
----------------------------------------------
select category,
sum(units_sold*unit_price) as revenue
from sales
group by category
order by revenue desc;
 
** Count of products in each region,descedning
-------------------------------------------------
select region,
count(product) as product_count from sales
group by region
order by product_count desc;

** Regions and total units sold,sorted by region
--------------------------------------------------
select region ,sum(units_sold) as total_units
from sales
group by region
order by region;

